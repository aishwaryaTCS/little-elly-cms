{
  "name": "little-elly-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:admin": "npm --prefix admin run dev",
    "seed": "node src/seed/seed.js",
    "seed:content": "node src/seed/seedContent.js",
    "build": "npm --prefix admin run build",
    "start": "node src/server.js",
    "test:e2e": "node --test tests/acceptance.e2e.test.js",
    "test": "node --test --test-concurrency=1 tests/boundaries.test.js tests/content.test.js tests/admin-api.test.js tests/public-api.test.js tests/seed.test.js"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.4",
    "multer": "^2.0.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
