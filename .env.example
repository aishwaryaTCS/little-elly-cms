MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/little-elly-cms
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@littleelly.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_NAME=Little Elly Admin
CLIENT_ORIGINS=http://localhost:5173
STORAGE_DRIVER=local
COOKIE_SECURE=false
TRUST_PROXY=0

